	            for path in include_paths:
	                clang_args.append(f'-I{path}')
	
	        try:
	            self.tu = self.index.parse(self.source_file, args=clang_args)
	        except cindex.TranslationUnitLoadError:
	             # This is a fallback for severe, unrecoverable parsing errors
	             print(f"  [FATAL] A TranslationUnitLoadError occurred. This can be caused by a missing file or a deep C++-level error in libclang.", file=sys.stderr)
	             raise # Re-raise the exception to be caught by the main loop
	
	        if not self.tu:
	            raise RuntimeError("Clang failed to create a translation unit.")
	        
	        has_errors = False
	        error_messages = []
	        for diag in self.tu.diagnostics:
	            if diag.severity >= cindex.Diagnostic.Error:
	                has_errors = True
	                error_message = (
	                    f"  [Clang Diagnostic] Severity: {diag.severity} | File: {diag.location.file} | Line: {diag.location.line}\n"
	                    f"  Message: {diag.spelling}"
	                )
	                error_messages.append(error_message)
	        
	        if has_errors:
	            full_error_log = "\n".join(error_messages)
	            raise RuntimeError(f"Error parsing translation unit. Clang diagnostics:\n{full_error_log}")
	
