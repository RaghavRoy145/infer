	import pandas as pd
	import matplotlib.pyplot as plt
	import seaborn as sns
	from tabulate import tabulate
	
	def plot_skip_patches_pareto(df):
	    skip_df = df[df['patch_type'].isin(['Guarded Block', 'Early Exit'])].copy()
	    skip_df['L_local_norm'] = pd.to_numeric(skip_df['L_local_norm'], errors='coerce')
	    skip_df['cost_g_overhead'] = pd.to_numeric(skip_df['cost_g_overhead'], errors='coerce')
	    
	    if skip_df.empty:
	        print("No 'Skip' type patches found to generate Pareto plot.")
	        return
	
	    plt.style.use('seaborn-v0_8-whitegrid')
	    fig, ax = plt.subplots(figsize=(12, 8))
	
	    sns.scatterplot(data=skip_df, x='L_local_norm', y='cost_g_overhead', hue='tool_name', style='patch_type', s=120, ax=ax)
	    
	    ax.set_title('Control-Flow Patch Quality: Overhead vs. Normalized Imprecision', fontsize=16)
	    ax.set_xlabel('Normalized Imprecision Cost (L_local_norm)', fontsize=12)
	    ax.set_ylabel('Overhead Cost (G)', fontsize=12)
	    ax.legend(title='Tool / Patch Type')
	    plt.tight_layout()
	    plt.savefig('skip_patches_pareto_plot.png')
	    print("Saved Control-Flow (Skip) patch Pareto plot to skip_patches_pareto_plot.png")
	    plt.close()
	
	def plot_replace_patches_cost(df):
	    replace_df = df[df['patch_type'] == 'Replace'].copy()
	    replace_df['cost_rep_modification'] = pd.to_numeric(replace_df['cost_rep_modification'], errors='coerce')
	
	    if replace_df.empty:
	        print("No 'Replace' type patches found to generate cost comparison plot.")
	        return
	
	    plt.style.use('seaborn-v0_8-whitegrid')
	    fig, ax = plt.subplots(figsize=(10, 6))
	
	    sns.barplot(data=replace_df, x='bug_id', y='cost_rep_modification', hue='tool_name', ax=ax)
	    
	    ax.set_title('Data-Flow Patch Quality: Modification Cost', fontsize=16)
	    ax.set_ylabel('Modification Cost (Cost_Rep)', fontsize=12)
	    ax.set_xlabel('Bug ID', fontsize=12)
	    ax.tick_params(axis='x', rotation=45)
	    ax.legend(title='Tool')
	    plt.tight_layout()
	    plt.savefig('replace_patches_cost_plot.png')
	    print("Saved Data-Flow (Replace) patch cost plot to replace_patches_cost_plot.png")
	    plt.close()
