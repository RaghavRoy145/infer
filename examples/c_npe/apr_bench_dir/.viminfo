	import pandas as pd
	import matplotlib.pyplot as plt
	import seaborn as sns
	from tabulate import tabulate
	
	def plot_pareto_frontier(df):
	    plt.style.use('seaborn-v0_8-whitegrid')
	    fig, ax = plt.subplots(figsize=(12, 8))
	
	    df_sorted = df.sort_values(by=['L_local_norm', 'cost_g_overhead'])
	    pareto_front = []
	    last_y = float('inf')
	    for index, row in df_sorted.iterrows():
	        if row['cost_g_overhead'] <= last_y:
	            pareto_front.append(row)
	            last_y = row['cost_g_overhead']
	    pareto_df = pd.DataFrame(pareto_front)
	
	    sns.scatterplot(
	        data=df, x='L_local_norm', y='cost_g_overhead',
	        hue='tool_name', style='patch_type', s=120, ax=ax, alpha=0.8
	    )
	
	    if not pareto_df.empty:
	        ax.plot(pareto_df['L_local_norm'], pareto_df['cost_g_overhead'], 'r--', alpha=0.7, label='Pareto Frontier')
	
	    ax.set_title('Patch Quality: Overhead vs. Normalized Local Imprecision', fontsize=16)
	    ax.set_xlabel('Normalized Local Imprecision (L_local_norm)', fontsize=12)
	    ax.set_ylabel('Absolute Overhead (cost_g)', fontsize=12)
	    ax.legend(title='Tool / Patch Type')
	    plt.tight_layout()
	    plt.savefig('pareto_frontier_plot.png')
	    print("Saved Pareto frontier plot to pareto_frontier_plot.png")
	    plt.close()
	
	def print_direct_comparison_table(df, function_name_str):
	    """
	    Finds comparable bugs based on function name and prints a comparison table.
	    """
	    # Find all bug_ids that involve the target function
	    comp_df = df[df['function_name'].str.strip() == function_name_str].copy()
	    if comp_df.shape[0] < 2:
	        print(f"\nCannot generate direct comparison for '{function_name_str}': Fewer than 2 tools patched this function.")
	        return
	
	    # Select and rename columns for clarity in the table
	    table_df = comp_df[[
	        'tool_name',
	        'patch_type',
