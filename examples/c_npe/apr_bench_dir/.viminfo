	import pandas as pd
	import matplotlib.pyplot as plt
	import seaborn as sns
	from tabulate import tabulate
	
	def _plot_single_pareto(ax, df, title):
	    """Helper function to plot a single Pareto frontier on a given matplotlib axis."""
	    # Ensure data is numeric
	    df['L_local_norm'] = pd.to_numeric(df['L_local_norm'], errors='coerce')
	    df['cost_g_overhead'] = pd.to_numeric(df['cost_g_overhead'], errors='coerce')
	    df.dropna(subset=['L_local_norm', 'cost_g_overhead'], inplace=True)
	
	    if df.empty:
	        ax.text(0.5, 0.5, 'No data available for this comparison.', ha='center', va='center')
	        ax.set_title(title, fontsize=14)
	        return
	
	    # Plot all the data points
	    sns.scatterplot(
	        data=df,
	        x='L_local_norm',
	        y='cost_g_overhead',
	        hue='tool_name',
	        style='patch_type',
	        s=120,
	        ax=ax,
	        alpha=0.8
	    )
	
	    # Identify and plot the Pareto Frontier for this specific subset of data
	    df_sorted = df.sort_values(by=['L_local_norm', 'cost_g_overhead'])
	    pareto_front = []
	    last_y = float('inf')
	    for _, row in df_sorted.iterrows():
	        if row['cost_g_overhead'] <= last_y:
	            pareto_front.append(row)
	            last_y = row['cost_g_overhead']
	    
	    if pareto_front:
	        pareto_df = pd.DataFrame(pareto_front)
	        ax.plot(pareto_df['L_local_norm'], pareto_df['cost_g_overhead'], 'r--', alpha=0.7, label='Pareto Frontier')
	
	    ax.set_title(title, fontsize=14)
	    ax.set_xlabel('Normalized Imprecision (L_local_norm)', fontsize=10)
	    ax.set_ylabel('Overhead Cost (G)', fontsize=10)
	    ax.legend()
	
	def generate_comparison_plots(df):
	    """
	    Generates a side-by-side figure comparing EffFix configurations against other tools.
