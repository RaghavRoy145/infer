"  -t, --type=TYPE                     nombre del tipo para el registro convertido;\n"
"                                        se omite este parámetro no se usará ningún tipo.\n"
"  -s, --strict                        ser estricto al analizar el archivo csv.\n"
"  -e, --omit-empty                    omitir campos vacíos.\n"

